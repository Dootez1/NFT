# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin IDs (comma-separated list of Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Gift recipient username and ID
GIFT_RECIPIENT=@YourEscrowRecipient
GIFT_RECIPIENT_ID=123456789

# Default offer duration in hours
OFFER_DURATION_HOURS=6

# Subscription duration in days
SUB_DURATION_DAYS=30

# Subscription prices in Telegram Stars
SUB_STANDARD_PRICE=100
SUB_PRO_PRICE=150
SUB_PREMIUM_PRICE=1000

# TON Payments
TON_WALLET_ADDRESS=EQ...
TONCENTER_API_KEY=
SUB_STANDARD_PRICE_TON=1.0
SUB_PRO_PRICE_TON=1.5
SUB_PREMIUM_PRICE_TON=10.0
